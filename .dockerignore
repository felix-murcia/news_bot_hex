# ============================================================
# Contexto de build — docker build .
# Docker recibe TODO el directorio salvo estas reglas, y el
# Dockerfile hace COPY . . — así que lo no listado aquí entra.
# ============================================================

# --- Sistema operativo y editores ---
.DS_Store
Thumbs.db
*.swp
*.swo
*.bak
*.tmp
.vscode/
.idea/
*.py[cod]
*$py.class
*.so
.Python

# --- Control de versiones e historial ---
.git/
.gitattributes
.gitignore
.github/
# Worktrees de herramientas de agente: replican el repo entero con
# dependencias propias.
.kilo/
.codegraph/
.claude/
.opencode/

# --- Entornos virtuales y dependencias ---
.venv/
venv/
env/
venv_news_bot/
**/node_modules/
**/package-lock.json
**/package.json
bun.lock
.yarn/

# --- Frontend: servicio aparte (tiene su propio Dockerfile + nginx),
#   la imagen de Python no lo necesita en runtime ---
frontend/

# --- Secretos: NUNCA deben entrar en la imagen ---
# docker-compose pasa .env vía env_file en tiempo de ejecución.
# Un .env copiado aquí acabaría en una capa de la imagen.
.env
.env.*
!.env.example

# --- Datos, modelos y artefactos generados ---
# Todos van montados como volúmenes en docker-compose.yml.
logs/
data/
models/
userdata/
profile/
debug/
*.log
*.jsonl
*.pid

# --- Fixtures de video: no se usan en runtime (son ejemplos/fixtures),
#   el pipeline genera video dinámicamente vía ffmpeg-api ---
video/

# --- Scripts de operación/mantenimiento: no son parte del runtime
#   del contenedor (CMD es uvicorn server:app) ---
scripts/
docker-compose.yml
Dockerfile

# --- Fixtures y capturas de depuración ---
# nt1-3.png y uh1-4.png fueron fixtures de una prueba de Facebook
# (8f0ef66); el publisher actual usa video_path del post.
# El único asset legítimo es logo__NBES.svg, que no coincide.
src/shared/utils/statics/images/*.png

# --- Tests: no se ejecutan en runtime ---
tests/
test/
pytest.ini
conftest.py
.coverage
htmlcov/
.pytest_cache/
.ruff_cache/
.mypy_cache/
**/__pycache__/

# --- Documentación ---
*.md

# --- Configuración local de herramientas ---
run_dev.sh
run_prod.sh
install_timer.sh
.mcp.json
.mcp.jsonc
