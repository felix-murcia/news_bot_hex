# ============================================================================
# .env.test — minimal, SECRET-FREE test environment.
#
# Used by CI (.github/workflows/ci.yml) and reproducible locally.
#
# How to use (matches CI exactly):
#     set -a; source .env.test; set +a
#     python -m pytest tests/ -v
#
# Why sourcing works even though config/settings.py calls load_dotenv():
# load_dotenv() is called WITHOUT override=True, so real environment
# variables always win over any .env file. Sourcing therefore gives the
# tests a deterministic environment instead of whatever the developer
# happens to have locally.
#
# This file MUST NOT contain real credentials. Social network values below
# are inert placeholders: they only need to be non-empty because the
# publisher modules refuse to import when the value is missing. No test
# performs a network call with them.
# ============================================================================

# --- Paths ------------------------------------------------------------------
# NOTE: must point at a real directory. The production .env uses /app, which
# does not exist on a developer host or on a CI runner, and mkdir would fail
# with PermissionError. ${GITHUB_WORKSPACE:-.} keeps this portable: the CI
# workspace, or the current directory when run locally.
BASE_DIR=${GITHUB_WORKSPACE:-.}
DATA_DIR=${BASE_DIR}/data
CACHE_DIR=${BASE_DIR}/data/cache
MODELS_DIR=${BASE_DIR}/models
IMAGES_DIR=${BASE_DIR}/data/images
LOG_DIR=${BASE_DIR}/logs

# --- MongoDB ----------------------------------------------------------------
# 127.0.0.1 reaches the `mongodb` service container declared in ci.yml.
#
# Credentials are intentionally EMPTY because the CI service runs `mongo:7`
# without authentication. The production Mongo (docker-compose network
# `mongo_default`) DOES require auth (root/rootpassword in .env) — that is why
# sourcing this file locally against the production DB will fail to read
# collections unless you re-export MONGO_USER / MONGO_PASSWORD.
MONGO_HOST=127.0.0.1
MONGO_PORT=27017
MONGO_USER=
MONGO_PASSWORD=
# La suite NUNCA debe escribir en appdb (producción). El conftest raíz
# (conftest.py) inyecta la BD de pruebas y deja constancia de appdb solo
# para los tests marcados `production`, que son opt-in.
# Ver: NEWS_BOT_RUN_PRODUCTION_TESTS=1
MONGO_DB_NAME=appdb_test

# --- AI ---------------------------------------------------------------------
# `mock` keeps the suite offline and deterministic: no provider credentials,
# no network, no quota consumption.
AI_PROVIDER=mock
GEMINI_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=

# --- FFmpeg service ---------------------------------------------------------
# No ffmpeg-api in CI; steps that need it are expected to fail-fast or be
# mocked. Kept explicit so the value is not inherited from the host.
FFMPEG_API_URL=http://localhost:8082

# --- Social publishers (inert placeholders, see note above) ------------------
FACEBOOK_PAGE_ID=test-page-id
FACEBOOK_PAGE_ACCESS_TOKEN=test-page-token
MASTODON_INSTANCE_URL=https://mastodon.social
MASTODON_ACCESS_TOKEN=test-access-token
BLUESKY_HANDLE=test.bsky.social
BLUESKY_APP_PASSWORD=test-app-password